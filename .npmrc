# React Native의 Metro 번들러는 pnpm의 기본 격리형(symlink) node_modules
# 구조를 완전히 이해하지 못해서, nativewind가 내부적으로 쓰는
# react-native-css-interop 같은 간접 의존성을 react-native 패키지 자신의
# 파일에서 못 찾는 문제가 있었다(apps/mobile 스캐폴딩 중 발견). Expo/RN
# 커뮤니티가 권장하는 대로 평탄한(hoisted) node_modules 구조로 바꿔서
# 해결한다. 다른 앱(frontend/backend)의 동작에는 영향 없음(둘 다
# 평탄한 구조에서도 정상 동작 확인).
node-linker=hoisted
